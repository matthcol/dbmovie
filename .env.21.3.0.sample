# Sample env file for Oracle Database 21c Express Edition
# Copy to .env (or pass --env-file) before: docker compose build / up
# cp .env.21.3.0.sample .env

ORACLE_VERSION=21.3.0
ORACLE_DOCKERFILE=Dockerfile.xe
ORACLE_EDITION_SUFFIX=xe

DB_ROOT_PASSWORD=password
DB_CHARSET=AL32UTF8
DB_PORT=1521
EM_PORT=5500
