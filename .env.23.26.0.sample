# Sample env file for Oracle Database 23ai Free
# Copy to .env (or pass --env-file) before: docker compose build / up
# cp .env.23.26.0.sample .env
# Fetch the matching Dockerfile first: ./fetch-oracle-dockerfiles.sh 23.26.0

ORACLE_VERSION=23.26.0
ORACLE_DOCKERFILE=Containerfile.free
ORACLE_EDITION_SUFFIX=free

DB_ROOT_PASSWORD=password
DB_CHARSET=AL32UTF8
DB_PORT=1521
EM_PORT=5500
